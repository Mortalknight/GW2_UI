<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <Button name="GwOptionBoxTmpl" frameStrata="HIGH" virtual="true">
        <Size x="244" y="40"/>
        <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
        </Anchors>
        <Layers>
            <Layer level="OVERLAY" textureSubLevel="2">
                <FontString parentKey="title" text="Settings" inherits="GameFontNormalSmall" justifyH="LEFT">
                    <Size x="200" y="25"/>
                    <Color r="1" b="1" g="1"/>
                    <Anchors>
                        <Anchor point="LEFT" x="35" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <CheckButton parentKey="checkbutton" checked="true">
                <HitRectInsets left="0" right="0" top="0" bottom="0"/>
                <Size x="16" y="16"/>
                <Anchors>
                    <Anchor point="LEFT" relativePoint="LEFT" x="5"/>
                </Anchors>
                <NormalTexture file="Interface/AddOns/GW2_UI/textures/uistuff/checkbox.png"/>
                <CheckedTexture file="Interface/AddOns/GW2_UI/textures/uistuff/checkboxchecked.png"/>
            </CheckButton>
        </Frames>
    </Button>

    <Button name="GwOptionBoxSliderTmpl" frameStrata="HIGH" virtual="true">
        <Size x="500" y="40"/>
        <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
        </Anchors>
        <Layers>
            <Layer level="OVERLAY" textureSubLevel="2">
                <FontString parentKey="title" text="Settings" inherits="GameFontNormalSmall" justifyH="LEFT">
                    <Size x="200" y="25"/>
                    <Color r="1" b="1" g="1"/>
                    <Anchors>
                        <Anchor point="LEFT" x="5" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Slider parentKey="slider" orientation="HORIZONTAL" enableMouse="true">
                <Size x="205" y="20"/>
                <Anchors>
                    <Anchor point="RIGHT" relativePoint="RIGHT" x="-60"/>
                </Anchors>
                <HitRectInsets left="0" right="0" top="-10" bottom="-10"/>
                <ThumbTexture file="Interface/AddOns/GW2_UI/textures/uistuff/sliderhandle.png">
                    <Size x="16" y="16"/>
                </ThumbTexture>
                <Layers>
                    <Layer>
                        <Texture file="Interface/AddOns/GW2_UI/textures/uistuff/sliderbg.png">
                            <Size y="12"/>
                            <Anchors>
                                <Anchor point="LEFT" relativePoint="LEFT" x="2" y="0"/>
                                <Anchor point="RIGHT" relativePoint="RIGHT" x="-2" y="0"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                    <Layer level="OVERLAY" textureSubLevel="2">
                        <FontString parentKey="sliderMinText" inherits="GameFontNormalSmall" justifyH="LEFT">
                            <Size x="80" y="10"/>
                            <Color r="0.62" g="0.58" b="0.5" a="0.9"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" x="2" y="-1"/>
                            </Anchors>
                        </FontString>
                        <FontString parentKey="sliderMaxText" inherits="GameFontNormalSmall" justifyH="RIGHT">
                            <Size x="80" y="10"/>
                            <Color r="0.62" g="0.58" b="0.5" a="0.9"/>
                            <Anchors>
                                <Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT" x="-2" y="-1"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Slider>
            <Frame parentKey="inputFrame" inherits="GwStandardInputField">
                <Size x="46" y="20"/>
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.slider" relativePoint="RIGHT" x="10" y="0"/>
                </Anchors>
            </Frame>
        </Frames>
    </Button>

    <Button name="GwOptionBoxColorPickerTmpl" frameStrata="HIGH" virtual="true">
        <Size x="500" y="40"/>
        <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
        </Anchors>
        <Layers>
            <Layer level="OVERLAY" textureSubLevel="2">
                <FontString parentKey="title" text="Settings" inherits="GameFontNormalSmall" justifyH="LEFT">
                    <Size x="235" y="25"/>
                    <Color r="1" b="1" g="1"/>
                    <Anchors>
                        <Anchor point="LEFT" x="5" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="button">
                <Size x="250" y="20"/>
                <Anchors>
                    <Anchor point="RIGHT" relativePoint="RIGHT" x="-10" y="0"/>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture file="Interface/AddOns/GW2_UI/textures/uistuff/gwstatusbar-bg.png">
                            <Anchors>
                               <Anchor point="TOPLEFT" relativePoint="TOPLEFT"/>
                                <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                    <Layer level="ARTWORK" textureSubLevel="2">
                        <Texture parentKey="bg" file="Interface/AddOns/GW2_UI/textures/uistuff/gwstatusbar.png">
                            <Anchors>
                                <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="1" y="-1"/>
                                <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-1" y="1"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Button>
        </Frames>
    </Button>

    <Button name="GwOptionBoxDropDownTmpl" frameStrata="HIGH" virtual="true">
        <Size x="500" y="40"/>
        <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
        </Anchors>
        <Layers>
            <Layer level="OVERLAY" textureSubLevel="2">
                <FontString parentKey="title" text="Settings" inherits="GameFontNormalSmall" justifyH="LEFT">
                    <Size x="235" y="25"/>
                    <Color r="1" b="1" g="1"/>
                    <Anchors>
                        <Anchor point="LEFT" x="5" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
       <Frames>
            <DropdownButton parentKey="dropDown" inherits="WowStyle1DropdownTemplate">
                <Size x="260" y="25"/>
                <Anchors>
                    <Anchor point="RIGHT" relativePoint="RIGHT" x="-10" y="0"/>
                </Anchors>
            </DropdownButton>
        </Frames>
    </Button>

    <Button name="GwOptionBoxListTmpl" frameStrata="HIGH" virtual="true">
        <Size x="500" y="40"/>
        <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
        </Anchors>
        <Layers>
            <Layer level="OVERLAY" textureSubLevel="2">
                <FontString parentKey="title" text="Settings" inherits="GameFontNormalSmall" justifyH="LEFT">
                    <Size x="235" y="25"/>
                    <Color r="1" b="1" g="1"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" x="5" y="-2"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="list">
                <Size x="260" y="20"/>
                <Anchors>
                    <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" x="-10" y="0"/>
                </Anchors>
            </Frame>
        </Frames>
    </Button>

    <Button name="GwOptionBoxTextTmpl" frameStrata="HIGH" virtual="true">
        <Size x="500" y="40"/>
        <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
        </Anchors>
        <Layers>
            <Layer level="OVERLAY" textureSubLevel="2">
                <FontString parentKey="title" text="Settings" inherits="GameFontNormalSmall" justifyH="LEFT">
                    <Size x="256" y="25"/>
                    <Color r="1" b="1" g="1"/>
                    <Anchors>
                        <Anchor point="LEFT" x="5" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="inputFrame" inherits="GwStandardInputField">
                <Size x="250" y="20"/>
                <Anchors>
                    <Anchor point="RIGHT" relativePoint="RIGHT" x="-15" y="0"/>
                </Anchors>
            </Frame>
        </Frames>
    </Button>

    <Button name="GwOptionBoxSpellInputTmpl" frameStrata="HIGH" virtual="true">
        <Size x="500" y="40"/>
        <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
        </Anchors>
        <Layers>
            <Layer level="OVERLAY" textureSubLevel="2">
                <FontString parentKey="title" text="Settings" inherits="GameFontNormalSmall" justifyH="LEFT">
                    <Size x="235" y="25"/>
                    <Color r="1" b="1" g="1"/>
                    <Anchors>
                        <Anchor point="LEFT" x="5" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="okButton" inherits="GwStandardButton" text="OKAY">
                <Size x="50" y="20"/>
                <Anchors>
                    <Anchor point="RIGHT" relativePoint="RIGHT" x="-10" y="0"/>
                </Anchors>
            </Button>
            <Frame parentKey="inputFrame" inherits="GwStandardInputField">
                <Size x="60" y="20"/>
                <Anchors>
                    <Anchor point="RIGHT" relativeKey="$parent.okButton" relativePoint="LEFT" x="-5" y="0"/>
                </Anchors>
            </Frame>
            <Button parentKey="clearButton">
                <Size x="15" y="15"/>
                <Anchors>
                    <Anchor point="RIGHT" relativeKey="$parent.inputFrame" relativePoint="LEFT" x="-5" y="0"/>
                </Anchors>
            </Button>
            <Frame parentKey="spellPreview" enableMouse="true">
                <Size x="0" y="20"/>
                <Anchors>
                    <Anchor point="LEFT" x="280" y="0"/>
                    <Anchor point="RIGHT" relativeKey="$parent.clearButton" relativePoint="LEFT" x="-5" y="0"/>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture parentKey="icon">
                            <Size x="18" y="18"/>
                            <Anchors>
                                <Anchor point="LEFT"/>
                            </Anchors>
                            <TexCoords left="0.1" right="0.9" top="0.1" bottom="0.9"/>
                        </Texture>
                    </Layer>
                    <Layer level="OVERLAY">
                        <FontString parentKey="label" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent.icon" relativePoint="RIGHT" x="4" y="0"/>
                                <Anchor point="RIGHT"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
    </Button>

    <Button name="GwOptionBoxSpellListTmpl" frameStrata="HIGH" virtual="true">
        <Size x="500" y="40"/>
        <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
        </Anchors>
        <Layers>
            <Layer level="OVERLAY" textureSubLevel="2">
                <FontString parentKey="title" text="Settings" inherits="GameFontNormalSmall" justifyH="LEFT">
                    <Size x="235" y="25"/>
                    <Color r="1" b="1" g="1"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" x="5" y="-8"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="inputFrame" inherits="GwStandardInputField">
                <Size x="180" y="20"/>
                <Anchors>
                    <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" x="-70" y="-10"/>
                </Anchors>
            </Frame>
            <Button parentKey="okButton" inherits="GwStandardButton" text="OKAY">
                <Size x="50" y="20"/>
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.inputFrame" relativePoint="RIGHT" x="5" y="0"/>
                </Anchors>
            </Button>
            <Frame parentKey="list">
                <Size x="260" y="20"/>
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeKey="$parent.okButton" relativePoint="BOTTOMRIGHT" x="0" y="-5"/>
                </Anchors>
            </Frame>
        </Frames>
    </Button>

    <Button name="GwButtonTextTmpl" inherits="GwStandardButton" frameStrata="HIGH" virtual="true">
        <Size x="244" y="40"/>
        <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
        </Anchors>
        <Layers>
            <Layer level="OVERLAY" textureSubLevel="2">
                <FontString parentKey="title" text="Settings" inherits="GameFontNormalSmall" justifyH="CENTER">
                    <Size x="200" y="25"/>
                    <Anchors>
                        <Anchor point="CENTER" x="0" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Button>

    <Frame name="GwOptionBoxHeader" frameStrata="HIGH" virtual="true">
        <Size x="600" y="40"/>
        <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
        </Anchors>
        <Layers>
            <Layer level="OVERLAY" textureSubLevel="2">
                <FontString parentKey="title" text="SettingsHeader" inherits="GameFontNormal" justifyH="LEFT">
                    <Size x="600" y="25"/>
                    <Anchors>
                        <Anchor point="LEFT" x="12" y="-6"/>
                    </Anchors>
                </FontString>
                <Texture parentKey="seperator" file="Interface/AddOns/GW2_UI/textures/hud/levelreward-sep.png">
                    <Color r="1" g="1" b="1" a="0.65"/>
                    <Size x="360" y="2"></Size>
                    <TexCoords left="0.5" right="1" top="0" bottom="1"/>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" x="12" y="-5"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="accent">
                    <Color r="1" g="1" b="1" a="0.85"/>
                    <Size x="5" y="5"></Size>
                    <TexCoords left="0.5" right="1" top="0" bottom="1"/>
                    <Anchors>
                        <Anchor point="LEFT" x="2" y="-6"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
    </Frame>

    <Frame name="GwOptionBoxNote" frameStrata="HIGH" virtual="true">
        <Size x="550" y="40"/>
        <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="background">
                    <Color r="0" g="0" b="0" a="0.25"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" x="5" y="0"/>
                        <Anchor point="BOTTOMRIGHT" x="-10" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="accent">
                    <Color r="1" g="0.85" b="0.5" a="0.85"/>
                    <Size x="2" y="0"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" x="5" y="0"/>
                        <Anchor point="BOTTOMLEFT" x="5" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY" textureSubLevel="2">
                <FontString parentKey="title" text="SettingsNote" inherits="GameFontNormalSmall" justifyH="LEFT" justifyV="TOP" nonspacewrap="false">
                    <Size x="520" y="0"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" x="15" y="-6"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>

    <Frame name="GwOptionBoxSubHeader" frameStrata="HIGH" virtual="true">
        <Size x="600" y="40"/>
        <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
        </Anchors>
        <Layers>
            <Layer level="OVERLAY" textureSubLevel="2">
                <FontString parentKey="title" text="SettingsSubHeader" inherits="GameFontNormalSmall" justifyH="LEFT">
                    <Size x="560" y="22"/>
                    <Anchors>
                        <Anchor point="LEFT" x="15" y="-2"/>
                    </Anchors>
                </FontString>
                <Texture parentKey="seperator" file="Interface/AddOns/GW2_UI/textures/hud/levelreward-sep.png">
                    <Color r="1" g="1" b="1" a="0.45"/>
                    <Size x="300" y="1"></Size>
                    <TexCoords left="0.5" right="1" top="0" bottom="1"/>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" x="15" y="-5"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
    </Frame>

</Ui>
