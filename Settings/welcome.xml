<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <Frame name="GwWelcomePageTmpl" virtual="true">
        <Size x="512" y="512"/>
        <Anchors>
            <Anchor point="CENTER" relativePoint="CENTER" x="0" y="30"/>
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="background" file="Interface/AddOns/GW2_UI/textures/uistuff/settingssplash.png">
                <Size x="1024" y="1024"/>
                    <Anchors>
                        <Anchor point="CENTER"/>

                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <FontString parentKey="header" text="Welcome to Gw2 UI" justifyH="CENTER">
                    <Anchors>
                        <Anchor point="TOP" x="0" y="15"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="subHeader" text="{VERSION}" justifyH="CENTER">
                    <Anchors>
                        <Anchor point="TOP" relativePoint="BOTTOM" relativeKey="$parent.header" x="0" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
        </Frames>
    </Frame>

</Ui>
