<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <Button name="GwSkillsHeaderTemplate" virtual="true">
        <Size x="330" y="30"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="bg" file="Interface\AddOns\GW2_UI\textures\talents\spell-sep.png" setAllPoints="true"/>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="Name" justifyH="LEFT" text="Unknown">
                    <Size x="280" y="20"/>
                    <Anchors>
                        <Anchor point="LEFT" x="10" y="0"/>
                    </Anchors>
                </FontString>
                <Texture parentKey="arrow" file="Interface\AddOns\GW2_UI\textures\uistuff\arrowdown_down.png">
                    <Size x="28" y="28"/>
                    <Anchors>
                        <Anchor point="RIGHT" x="-5" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
    </Button>

    <Button name="GwSkillsEntryTemplate" virtual="true">
        <Size x="330" y="44"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="zebra" file="Interface\AddOns\GW2_UI\textures\character\menu-bg.png" setAllPoints="true"/>
                <Texture parentKey="selected" file="Interface\AddOns\GW2_UI\textures\character\menu-hover.png" setAllPoints="true" hidden="true"/>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="Name" justifyH="LEFT" text="Unknown">
                    <Size x="150" y="20"/>
                    <Anchors>
                        <Anchor point="LEFT" x="10" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <StatusBar parentKey="Bar" minValue="0" maxValue="1" defaultValue="0">
                <Size x="140" y="16"/>
                <Anchors>
                    <Anchor point="RIGHT" x="-8" y="0"/>
                </Anchors>
                <BarTexture file="Interface\AddOns\GW2_UI\textures\uistuff\gwstatusbar.png"/>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="text" justifyH="CENTER" setAllPoints="true"/>
                    </Layer>
                </Layers>
            </StatusBar>
            <Button parentKey="abandon" hidden="true">
                <Size x="18" y="18"/>
                <Anchors>
                    <Anchor point="RIGHT" relativeKey="$parent.Bar" relativePoint="LEFT" x="-10" y="0"/>
                </Anchors>
                <NormalTexture file="Interface\AddOns\GW2_UI\textures\uistuff\window-close-button-normal.png"/>
                <HighlightTexture file="Interface\AddOns\GW2_UI\textures\uistuff\window-close-button-hover.png"/>
            </Button>
        </Frames>
    </Button>

    <Frame name="GwSkillsPanelTemplate" inherits="SecureHandlerBaseTemplate" hidden="true" virtual="true">
        <Size x="608" y="621"/>
        <Anchors>
            <Anchor point="TOPLEFT" x="245" y="-5"/>
        </Anchors>
        <Layers>
            <Layer level="ARTWORK">
                <Texture file="Interface\AddOns\GW2_UI\textures\character\paperdollbg.png" setAllPoints="true"/>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="backButton" inherits="GwCharacterPanelMenuButtonBackSecureTemplate" text="Character: Skills">
                <Size x="231" y="50"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="-232" y="-10"/>
                </Anchors>
            </Button>
            <Frame parentKey="ScrollBox" inherits="WowScrollBoxList">
                <Size x="330" y="590"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="10" y="-15"/>
                </Anchors>
            </Frame>
            <EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPRIGHT" x="-4" y="0"/>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBox" relativePoint="BOTTOMRIGHT" x="-4" y="0"/>
                </Anchors>
            </EventFrame>
            <Frame parentKey="Details">
                <Size x="235" y="590"/>
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-13" y="-15"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Title" justifyH="CENTER" justifyV="TOP">
                            <Size x="235" y="40"/>
                            <Anchors>
                                <Anchor point="TOP" x="0" y="-10"/>
                            </Anchors>
                        </FontString>
                        <FontString parentKey="Description" justifyH="LEFT" justifyV="TOP" nonspacewrap="false">
                            <Size x="215" y="0"/>
                        </FontString>
                        <FontString parentKey="Empty" justifyH="CENTER" justifyV="MIDDLE" hidden="true">
                            <Size x="200" y="60"/>
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <Frames>
                    <StatusBar parentKey="RankBar" minValue="0" maxValue="1" defaultValue="0">
                        <Size x="200" y="18"/>
                        <Anchors>
                            <Anchor point="TOP" relativeKey="$parent.Title" relativePoint="BOTTOM" x="0" y="-8"/>
                        </Anchors>
                        <BarTexture file="Interface\AddOns\GW2_UI\textures\uistuff\gwstatusbar.png"/>
                        <Layers>
                            <Layer level="OVERLAY">
                                <FontString parentKey="text" justifyH="CENTER" setAllPoints="true"/>
                            </Layer>
                        </Layers>
                    </StatusBar>
                    <Frame parentKey="Rows">
                        <Size x="215" y="1"/>
                        <Anchors>
                            <Anchor point="TOP" relativeKey="$parent.Description" relativePoint="BOTTOM" x="0" y="-6"/>
                        </Anchors>
                    </Frame>
                </Frames>
            </Frame>
        </Frames>
    </Frame>
</Ui>
