<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <Frame name="GwSpellbook" enableMouse="true" virtual="true">
        <Size x="853" y="627"></Size>
        <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"></Anchor>
        </Anchors>
        <Layers>
            <Layer level="ARTWORK">
                <Texture file="Interface\AddOns\GW2_UI\textures\character\windowbg-brushed.png">
                    <Size x="853" y="853"></Size>
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"></Anchor>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="showAllSpellRanks">
                <Size x="200" y="20"/>
                <Anchors>
                    <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" x="-10" y="-10"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY" textureSubLevel="2">
                        <FontString parentKey="string" text="SHOW_ALL_SPELL_RANKS" inherits="ChatBubbleFont" justifyH="LEFT">
                            <Size x="200" y="20"/>
                            <Anchors>
                                <Anchor point="LEFT" x="25" y="0"></Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <Frames>
                    <CheckButton parentKey="checkbutton" checked="false">
                        <Size x="16" y="16"/>
                        <Anchors>
                            <Anchor point="RIGHT" relativePoint="RIGHT" x="5"/>
                        </Anchors>
                        <NormalTexture file="Interface/AddOns/GW2_UI/textures/uistuff/checkbox.png"/>
                        <CheckedTexture file="Interface/AddOns/GW2_UI/textures/uistuff/checkboxchecked.png"/>
                        <Scripts>
                            <OnShow>
                                self:SetChecked( GetCVarBool("ShowAllSpellRanks"))
                            </OnShow>
                        </Scripts>
                    </CheckButton>
                </Frames>
            </Button>
        </Frames>
    </Frame>

</Ui>