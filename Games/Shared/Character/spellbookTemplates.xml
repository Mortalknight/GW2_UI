<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <Frame name="GwSpellbookActionButtonHeaderTemplate" virtual="true">
        <Size x="304" y="64"/>
        <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
        </Anchors>
        <Layers>
            <Layer level="BORDER">
                <FontString parentKey="title" text="Unknown" justifyH="LEFT" justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="13" y="-10"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="subTitle" text="" justifyH="LEFT" justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.title" relativePoint="BOTTOMLEFT" x="0" y="0"/>
                    </Anchors>
                    <Color r="0.5" g="0.5" b="0.5" a="1"/>
                </FontString>
            </Layer>
        </Layers>
    </Frame>

    <Frame name="GwSpellbookMenu" inherits="SecureHandlerAttributeTemplate" virtual="true">
        <Size x="241" y="621"/>
        <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="-10"/>
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND" textureSubLevel="-2">
                <Texture file="Interface\AddOns\GW2_UI\textures\talents\spellbookmenu_background.png">
                    <Size x="241" y="512"/>
                    <Color r="1" g="1" b="1" a="1"></Color>
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="8"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
    </Frame>

    <Button name="GwspellbookTab" inherits="GwCharacterMenuBlankTemplate,SecureHandlerStateTemplate,SecureHandlerClickTemplate,SecureHandlerBaseTemplate" virtual="true">
        <Size x="231" y="44"/>
        <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
        </Anchors>
        <HitRectInsets left="0.2" right="-0.2" top="0.2" bottom="0"/>
        <Layers>
            <Layer level="BACKGROUND" >
                <Texture parentKey="bg" file="Interface\AddOns\GW2_UI\textures\character\menu-bg.png">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
                        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="0" y="0"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="bgstatic" file="Interface\AddOns\GW2_UI\textures\character\menu-bg.png">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
                        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="0" y="0"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="background" alphaMode="ADD" file="Interface\AddOns\GW2_UI\textures\button_hover.png" hidden="true">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
                            <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="0" y="0"/>
                    </Anchors>
                    <Color r="1" g="1" b="0.6" a="0.1"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentkey="icon" file="Interface\AddOns\GW2_UI\textures\levelreward-icon.png">
                    <Size x="32" y="32"/>
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="LEFT" x="10" y="0"/>
                    </Anchors>
                    <TexCoords left="0.1" right="0.9" top="0.1" bottom="0.9" />
                </Texture>
                <FontString parentKey="title" text="Unknown" justifyH="LEFT" justifyV="MIDDLE">
                    <Size x="32" y="32"/>
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="RIGHT" relativeKey="$parent.icon" x="5" y="0"/>
                        <Anchor point="RIGHT" relativePoint="RIGHT" x="5" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Button>

    <Frame name="GwSpellbookPageTemplate" inherits="SecureHandlerShowHideTemplate" enableMouse="false" hidden="true" virtual="true">
        <Size x="608" y="541"/>
        <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0" />
        </Anchors>
        <Scripts>
            <OnShow>
                self:GetParent().pages:SetText(self:GetID())
            </OnShow>
        </Scripts>
    </Frame>

    <Frame name="GwSpellbookContainerTab" inherits="SecureHandlerShowHideTemplate,SecureHandlerStateTemplate" virtual="true">
        <Size x="611" y="581"/>
        <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="241" y="-37"/>
            <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="0" y="10"/>
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="headerbg" file="Interface\AddOns\GW2_UI\textures\talents\talents_header.png">
                    <Size x="512" y="32"/>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <FontString parentKey="title" text="Unknown" justifyH="LEFT" justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="LEFT" relativeKey="$parent.headerbg" x="5" y="0"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="pages" text="0" justifyH="LEFT" justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="BOTTOM" relativePoint="BOTTOM"  x="0" y="10"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="attrDummy" inherits="SecureHandlerAttributeTemplate">
            </Frame>
            <Frame name="$parentcontainer1" parentKey="container1" inherits="GwSpellbookPageTemplate" id="1" hidden="false"/>
            <Button parentKey="left" enableMouse="true" inherits="SecureHandlerClickTemplate,SecureHandlerShowHideTemplate,SecureHandlerStateTemplate"  >
                <size x="32" y="32"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOM"  x="-30" y="5" />
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY" textureSubLevel="8">
                        <Texture file="Interface\AddOns\GW2_UI\textures\character\backicon.png">
                            <Size x="32" y="32"></Size>
                            <Anchors>
                                <Anchor point="LEFT" relativePoint="LEFT"></Anchor>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Button>
            <Button parentKey="right" enableMouse="true" inherits="SecureHandlerClickTemplate,SecureHandlerShowHideTemplate,SecureHandlerStateTemplate"  >
                <size x="32" y="32"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativePoint="BOTTOM"  x="30" y="5" />
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY" textureSubLevel="8">
                        <Texture file="Interface\AddOns\GW2_UI\textures\character\forwardicon.png">
                            <Size x="32" y="32"></Size>
                            <Anchors>
                                <Anchor point="LEFT" relativePoint="LEFT"></Anchor>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Button>
        </Frames>
    </Frame>

    <Frame name="GwSpellbookActionBackground" virtual="true">
        <Size x="304" y="64"/>
        <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND"/>
            <Layer level="BORDER">
                <FontString parentKey="title" text="Unknown" justifyH="LEFT" justifyV="MIDDLE">
                    <Size x="256" y="20"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="15" y="-10"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                self.title:SetFont(DAMAGE_TEXT_FONT, 14, "OUTLINE")
            </OnLoad>
        </Scripts>
    </Frame>

    <Button name="GwSpellbookActionbutton" enableMouse="true" inherits="SecureActionButtonTemplate,SecureHandlerDragTemplate" virtual="true">
        <Size x="40" y="40"/>
        <Layers>
            <Layer level="BACKGROUND">
            <Texture parentKey="outline" file="Interface\AddOns\GW2_UI\textures\talents\background_border.png">
                <Size x="50" y="50"/>
                    <Anchors>
                    <Anchor point="CENTER" relativePoint="CENTER"/>
                </Anchors>
            </Texture>
            </Layer>
            <Layer level="ARTWORK" textureSubLevel="2">
                <Texture parentKey="icon">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
                        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="0" y="0"/>
                    </Anchors>
                    <TexCoords left="0.1" right="0.9" top="0.1" bottom="0.9" />
                </Texture>
            </Layer>
            <Layer level="OVERLAY" >
                <Texture file="Interface\AddOns\GW2_UI\textures\party\manage-group-arrow.png" parentKey="arrow">
                    <Size x="16" y="32"/>
                    <Anchors>
                        <Anchor point="RIGHT" relativePoint="RIGHT" x="5"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY" textureSubLevel="2">
                <Texture file="Interface\AddOns\GW2_UI\textures\talents\autocast.png" parentKey="autocast">
                    <Size x="55" y="55"/>
                    <Anchors>
                        <Anchor point="CENTER" relativePoint="CENTER" x="0"/>
                    </Anchors>
                </Texture>
                <Texture file="Interface\AddOns\GW2_UI\textures\talents\spell-lock.png" parentKey="lock">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0"/>
                        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="0" y="0"/>
                    </Anchors>
                </Texture>
                <FontString parentKey="rank" text="" justifyH="RIGHT" justifyV="BOTTOM">
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="0" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="HIGHLIGHT">
                <Texture alphaMode="ADD" file="Interface\AddOns\GW2_UI\textures\talents\active_highlight.png" parentKey="highlight">
                    <Size x="40" y="40"/>
                    <Anchors>
                        <Anchor point="CENTER" relativePoint="CENTER"/>
                    </Anchors>
                    <Color r="1" b="0.6" g="1" a="0.9"></Color>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Cooldown parentKey="cooldown" inherits="CooldownFrameTemplate"/>
        </Frames>
    </Button>

</Ui>
