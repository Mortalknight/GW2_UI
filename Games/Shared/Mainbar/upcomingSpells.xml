<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <!-- a node of the level path: trainable now, the own level or a later level -->
    <Frame name="GwUpcomingRewardHeader" virtual="true">
        <Size x="476" y="30"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="line">
                    <Size x="2"/>
                    <Anchors>
                        <Anchor point="TOP" relativePoint="TOPLEFT" x="20" y="0"/>
                        <Anchor point="BOTTOM" relativePoint="BOTTOMLEFT" x="20" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="node">
                    <Size x="20" y="20"/>
                    <Anchors>
                        <Anchor point="CENTER" relativePoint="LEFT" x="21" y="0"/>
                    </Anchors>
                </Texture>
                <FontString parentKey="Name" justifyH="LEFT" wordwrap="false">
                    <Size x="200" y="20"/>
                    <Anchors>
                        <Anchor point="LEFT" x="40" y="0"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="info" justifyH="RIGHT" wordwrap="false">
                    <Size x="200" y="20"/>
                    <Anchors>
                        <Anchor point="RIGHT" x="-6" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>

    <Button name="GwUpcomingRewardRow" virtual="true">
        <Size x="476" y="44"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="line">
                    <Size x="2"/>
                    <Anchors>
                        <Anchor point="TOP" relativePoint="TOPLEFT" x="20" y="0"/>
                        <Anchor point="BOTTOM" relativePoint="BOTTOMLEFT" x="20" y="0"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="icon">
                    <TexCoords left="0.1" right="0.9" top="0.1" bottom="0.9" />
                    <Size x="32" y="32"></Size>
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="LEFT" x="40"></Anchor>
                    </Anchors>
                </Texture>

                <FontString parentKey="costString" justifyH="RIGHT">
                    <Size x="80" y="20"></Size>
                    <Anchors>
                        <Anchor point="RIGHT" relativePoint="RIGHT" x="-6" y="8"></Anchor>
                    </Anchors>
                </FontString>

                <FontString parentKey="ranks" justifyH="RIGHT" wordwrap="false">
                    <Size x="70" y="20"></Size>
                    <Anchors>
                        <Anchor point="RIGHT" relativeKey="$parent.costString" relativePoint="LEFT" x="-10" y="0"></Anchor>
                    </Anchors>
                </FontString>

                <FontString parentKey="name" justifyH="LEFT" text="Unknown" wordwrap="false">
                    <Size y="20"></Size>
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="LEFT" x="80" y="8"></Anchor>
                        <Anchor point="RIGHT" relativeKey="$parent.ranks" relativePoint="LEFT" x="-10" y="0"></Anchor>
                    </Anchors>
                </FontString>

                <FontString parentKey="requirementString" justifyH="LEFT" wordwrap="false">
                    <Size y="16"></Size>
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="LEFT" x="80" y="-10"></Anchor>
                        <Anchor point="RIGHT" relativePoint="RIGHT" x="-6" y="-10"></Anchor>
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="HIGHLIGHT">
                <Texture parentKey="hover" file="Interface/AddOns/GW2_UI/textures/character/menu-hover.png">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="34" y="0"/>
                        <Anchor point="BOTTOMRIGHT" x="0" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
    </Button>

    <!-- the rewards of a far level, only as icons -->
    <Frame name="GwUpcomingRewardStrip" virtual="true">
        <Size x="476" y="40"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="line">
                    <Size x="2"/>
                    <Anchors>
                        <Anchor point="TOP" relativePoint="TOPLEFT" x="20" y="0"/>
                        <Anchor point="BOTTOM" relativePoint="BOTTOMLEFT" x="20" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
    </Frame>

    <Frame name="GwLevelingRewards" hidden="true" virtual="true">
        <Size x="540" y="518"></Size>
        <Anchors>
            <Anchor point="CENTER" relativePoint="CENTER"></Anchor>
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentBackground" file="Interface/AddOns/GW2_UI/textures/hud/levelrewardframe.png">
                    <Size x="735" y="735"></Size>
                    <Anchors>
                        <Anchor point="CENTER"></Anchor>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <FontString parentKey="header" text="Upcoming Level Rewards">
                    <Size x="540" y="50"></Size>
                    <Anchors>
                        <!-- the ribbon of the art, scaled up with the window -->
                        <Anchor point="TOP" relativePoint="TOP" y="-26"></Anchor>
                    </Anchors>
                </FontString>
                <FontString parentKey="hint" justifyH="CENTER" hidden="true">
                    <Size x="400" y="120"></Size>
                    <Anchors>
                        <Anchor point="CENTER" relativePoint="CENTER" y="-10"></Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="ScrollBox" inherits="WowScrollBoxList">
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="24" y="-150"></Anchor>
                    <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-40" y="50"></Anchor>
                </Anchors>
            </Frame>
            <EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPRIGHT" x="6" y="0"></Anchor>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBox" relativePoint="BOTTOMRIGHT" x="6" y="0"></Anchor>
                </Anchors>
            </EventFrame>
            <EditBox parentKey="search" inherits="GwEditBoxTemplate">
                <Size y="22"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPLEFT" x="3" y="8"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.ScrollBar" relativePoint="TOPRIGHT" x="-3" y="8"/>
                </Anchors>
            </EditBox>
            <Button parentKey="CloseButton" inherits="GwStandardButton" text="Close">
                <Size x="70" y="20" />
                <Anchors>
                    <Anchor point="BOTTOM" relativePoint="BOTTOM" relativeTo="GwLevelingRewards" x="5" y="12"></Anchor>
                </Anchors>
            </Button>
        </Frames>
    </Frame>

</Ui>
