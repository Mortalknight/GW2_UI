<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <Button name="GW2_UIAlertFrameTemplate" parent="UIParent" hidden="true" frameStrata="DIALOG" virtual="true" inherits="AlertFrameTemplate,InsecureActionButtonTemplate">
        <Size x="300" y="101"/>
        <Anchors>
            <Anchor point="BOTTOM" x="0" y="128"/>
        </Anchors>
        <Animations>
            <AnimationGroup parentKey="animIn">
                <Alpha fromAlpha="1" toAlpha="0" duration="0" order="1"/>
                <Alpha fromAlpha="0" toAlpha="1" duration="0.2" order="2"/>
            </AnimationGroup>
            <AnimationGroup parentKey="waitAndAnimOut">
                <Alpha startDelay="4.05" fromAlpha="1" toAlpha="0" duration="1.5" parentKey="animOut">
                    <Scripts>
                        <OnFinished>
                            self:GetRegionParent():Hide();
                        </OnFinished>
                    </Scripts>
                </Alpha>
            </AnimationGroup>
        </Animations>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                </Texture>
                <FontString parentKey="Unlocked" inherits="GameFontBlackTiny">
                    <Size x="200" y="12"/>
                    <Anchors>
                        <Anchor point="TOP" x="27" y="-23"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="Name" inherits="GameFontHighlight" maxLines="2" justifyH="CENTER" justifyV="MIDDLE">
                    <Size x="155" y="36"/>
                    <Anchors>
                        <Anchor point="TOP" relativeKey="$parent.Unlocked" relativePoint="BOTTOM"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="Icon">
                <Size x="78" y="75"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="-4" y="-15"/>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture parentKey="Texture">
                            <Size x="52" y="52"/>
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent.$parent" x="7" y="0"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
    </Button>

</Ui>
