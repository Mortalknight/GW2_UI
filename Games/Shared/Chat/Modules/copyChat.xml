<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- without blizzards default enter and escape handling: its OnLoad registers those without an owner,
         from our load that taints the owner id counter all callback registries share -->
    <Frame name="GwCopyChatEditBoxTemplate" inherits="ScrollingEditBoxTemplate" virtual="true">
        <KeyValues>
            <KeyValue key="useDefaultEnterHandling" value="false" type="boolean"/>
            <KeyValue key="useDefaultEscapeHandling" value="false" type="boolean"/>
        </KeyValues>
    </Frame>
</Ui>
